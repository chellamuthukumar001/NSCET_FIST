# CAMPUSIQ Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campusiq_db

# Security & PII Salt
JWT_SECRET=campusiq_super_secret_jwt_key_2026
PII_SALT=nscet_theni_immutable_cryptographic_salt_2026

# AI / Vector Embedding Settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# YouTube Data API v3 Key (Optional - Fallback to OpenCourseWare/NPTEL is automatic)
# Free Tier: 10,000 quota units / day. search.list consumes 100 units / search.
# Get a key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here


