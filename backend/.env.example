# CAMPUSIQ Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/campusiq_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=campusiq_db

# Security & PII Salt
JWT_SECRET=campusiq_super_secret_jwt_key_2026
PII_SALT=nscet_theni_immutable_cryptographic_salt_2026

# AI / Vector Embedding Settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

